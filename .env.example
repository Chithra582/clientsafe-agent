# ClinSafe Agent Environment Configuration Template
# Copy to .env and provide your API keys if enabling cloud LLM providers

# Port and Host
PORT=8000
HOST=0.0.0.0
DEBUG=true

# LLM Providers (Optional: System operates fully offline via deterministic fallback if keys omitted)
LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_AGENT_ENDPOINT=https://agent-prod.lyzr.app/v2/chat

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Human-In-The-Loop Webhook Target (Slack, Teams, or local simulation endpoint)
HITL_WEBHOOK_URL=http://localhost:8000/api/webhook/hitl

# Enable heavy Presidio spaCy model if downloaded
ENABLE_PRESIDIO_HEAVY=false
